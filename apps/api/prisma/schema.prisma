datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Tenant {
  id        String    @id @default(uuid()) @db.Uuid
  name      String
  domain    String?
  isActive  Boolean   @default(true) @map("is_active")
  isDeleted Boolean   @default(false) @map("is_deleted")
  deletedAt DateTime? @map("deleted_at")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @default(now()) @updatedAt @map("updated_at")

  schools                      School[]
  roles                        Role[]
  users                        User[]
  numberSeries                 NumberSeries[]
  auditLogs                    AuditLog[]
  securityPolicy               SecurityPolicy?
  userSessions                 UserSession[]
  ipRestrictions               IpRestriction[]
  securityEvents               SecurityEvent[]
  schoolConfigurations         SchoolConfiguration[]
  brandingConfigurations       BrandingConfiguration[]
  classes                      ClassMaster[]
  sections                     SectionMaster[]
  classSections                ClassSection[]
  subjects                     SubjectMaster[]
  classSubjects                ClassSubject[]
  religions                    Religion[]
  studentCategories            StudentCategory[]
  castes                       Caste[]
  vehicleTypes                 VehicleType[]
  feeHeads                     FeeHead[]
  expenseHeads                 ExpenseHead[]
  departments                  Department[]
  designations                 Designation[]
  schoolSetupProgress          SchoolSetupProgress[]
  admissionApplications        AdmissionApplication[]
  students                     Student[]
  guardians                    Guardian[]
  studentGuardians             StudentGuardian[]
  studentEnrollments           StudentEnrollment[]
  studentDocuments             StudentDocument[]
  studentNotes                 StudentNote[]
  studentDisciplines           StudentDiscipline[]
  families                     Family[]
  familyGuardians              FamilyGuardian[]
  familyStudents               FamilyStudent[]
  guardianDocuments            GuardianDocument[]
  guardianNotes                GuardianNote[]
  schoolHolidays               SchoolHoliday[]
  studentAttendances           StudentAttendance[]
  studentAttendanceCorrections StudentAttendanceCorrection[]
  studentLeaves                StudentLeave[]
  staffAttendances             StaffAttendance[]
  staffLeaves                  StaffLeave[]
  academicTerms                AcademicTerm[]
  classTeacherAssignments      ClassTeacherAssignment[]
  subjectTeacherAssignments    SubjectTeacherAssignment[]
  schoolPeriods                SchoolPeriod[]
  timetableSlots               TimetableSlot[]
  homework                     Homework[]
  exams                        Exam[]
  examClasses                  ExamClass[]
  examSubjects                 ExamSubject[]
  examSchedules                ExamSchedule[]
  gradeScales                  GradeScale[]
  gradeBands                   GradeBand[]
  studentExamMarks             StudentExamMark[]
  studentPromotions            StudentPromotion[]
  financialYears               FinancialYear[]
  accountingPeriods            AccountingPeriod[]
  accounts                     Account[]
  feeStructures                FeeStructure[]
  feeInstallments              FeeInstallment[]
  studentFeeAssignments        StudentFeeAssignment[]
  feeConcessions               FeeConcession[]
  feeInvoices                  FeeInvoice[]
  feePayments                  FeePayment[]
  feeReceipts                  FeeReceipt[]
  studentAdvances              StudentAdvance[]
  creditNotes                  CreditNote[]
  feeRefunds                   FeeRefund[]
  vendors                      Vendor[]
  expenseBills                 ExpenseBill[]
  vendorPayments               VendorPayment[]
  journalEntries               JournalEntry[]
  bankAccounts                 BankAccount[]
  bankTransfers                BankTransfer[]
  bankStatementImports         BankStatementImport[]
  bankReconciliations          BankReconciliation[]
  financialIdempotencies        FinancialIdempotency[]
  employees                    Employee[]
  staffLeaveTypes              StaffLeaveType[]
  employeeLeaveBalances        EmployeeLeaveBalance[]
  leaveBalanceTransactions     LeaveBalanceTransaction[]
  salaryComponents             SalaryComponent[]
  salaryStructures             SalaryStructure[]
  employeeSalaryAssignments    EmployeeSalaryAssignment[]
  payrollConfigurations        PayrollConfiguration[]
  payrollPeriods               PayrollPeriod[]
  payrollRuns                  PayrollRun[]
  payrollAdjustments           PayrollAdjustment[]
  payrollPayments              PayrollPayment[]
  employeeSeparations          EmployeeSeparation[]

  @@map("tenants")
}

model School {
  id        String    @id @default(uuid()) @db.Uuid
  tenantId  String    @map("tenant_id") @db.Uuid
  code      String
  name      String
  isActive  Boolean   @default(true) @map("is_active")
  isDeleted Boolean   @default(false) @map("is_deleted")
  deletedAt DateTime? @map("deleted_at")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @default(now()) @updatedAt @map("updated_at")

  tenant                       Tenant                        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  academicYears                AcademicYear[]
  userSchools                  UserSchool[]
  ipRestrictions               IpRestriction[]
  configuration                SchoolConfiguration?
  branding                     BrandingConfiguration?
  classes                      ClassMaster[]
  sections                     SectionMaster[]
  classSections                ClassSection[]
  subjects                     SubjectMaster[]
  classSubjects                ClassSubject[]
  feeHeads                     FeeHead[]
  expenseHeads                 ExpenseHead[]
  departments                  Department[]
  designations                 Designation[]
  setupProgress                SchoolSetupProgress?
  admissionApplications        AdmissionApplication[]
  students                     Student[]
  guardians                    Guardian[]
  studentGuardians             StudentGuardian[]
  studentEnrollments           StudentEnrollment[]
  studentDocuments             StudentDocument[]
  studentNotes                 StudentNote[]
  studentDisciplines           StudentDiscipline[]
  families                     Family[]
  familyGuardians              FamilyGuardian[]
  familyStudents               FamilyStudent[]
  guardianDocuments            GuardianDocument[]
  guardianNotes                GuardianNote[]
  schoolHolidays               SchoolHoliday[]
  studentAttendances           StudentAttendance[]
  studentAttendanceCorrections StudentAttendanceCorrection[]
  studentLeaves                StudentLeave[]
  staffAttendances             StaffAttendance[]
  staffLeaves                  StaffLeave[]
  academicTerms                AcademicTerm[]
  classTeacherAssignments      ClassTeacherAssignment[]
  subjectTeacherAssignments    SubjectTeacherAssignment[]
  schoolPeriods                SchoolPeriod[]
  timetableSlots               TimetableSlot[]
  homework                     Homework[]
  exams                        Exam[]
  examClasses                  ExamClass[]
  examSubjects                 ExamSubject[]
  examSchedules                ExamSchedule[]
  gradeScales                  GradeScale[]
  gradeBands                   GradeBand[]
  studentExamMarks             StudentExamMark[]
  studentPromotions            StudentPromotion[]
  financialYears               FinancialYear[]
  accountingPeriods            AccountingPeriod[]
  accounts                     Account[]
  feeStructures                FeeStructure[]
  feeInstallments              FeeInstallment[]
  studentFeeAssignments        StudentFeeAssignment[]
  feeConcessions               FeeConcession[]
  feeInvoices                  FeeInvoice[]
  feePayments                  FeePayment[]
  feeReceipts                  FeeReceipt[]
  studentAdvances              StudentAdvance[]
  creditNotes                  CreditNote[]
  feeRefunds                   FeeRefund[]
  vendors                      Vendor[]
  expenseBills                 ExpenseBill[]
  vendorPayments               VendorPayment[]
  journalEntries               JournalEntry[]
  bankAccounts                 BankAccount[]
  bankTransfers                BankTransfer[]
  bankStatementImports         BankStatementImport[]
  bankReconciliations          BankReconciliation[]
  financialIdempotencies        FinancialIdempotency[]
  employees                    Employee[]
  staffLeaveTypes              StaffLeaveType[]
  employeeLeaveBalances        EmployeeLeaveBalance[]
  leaveBalanceTransactions     LeaveBalanceTransaction[]
  salaryComponents             SalaryComponent[]
  salaryStructures             SalaryStructure[]
  employeeSalaryAssignments    EmployeeSalaryAssignment[]
  payrollConfigurations        PayrollConfiguration[]
  payrollPeriods               PayrollPeriod[]
  payrollRuns                  PayrollRun[]
  payrollAdjustments           PayrollAdjustment[]
  payrollPayments              PayrollPayment[]
  employeeSeparations          EmployeeSeparation[]

  @@map("schools")
}

model Permission {
  id          String  @id @default(uuid()) @db.Uuid
  code        String  @unique
  description String?

  rolePermissions RolePermission[]

  @@map("permissions")
}

model Role {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  name      String
  isSystem  Boolean  @default(false) @map("is_system")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  tenant          Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  rolePermissions RolePermission[]
  userRoles       UserRole[]

  @@map("roles")
}

model RolePermission {
  roleId       String @map("role_id") @db.Uuid
  permissionId String @map("permission_id") @db.Uuid

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model User {
  id                  String    @id @default(uuid()) @db.Uuid
  tenantId            String    @map("tenant_id") @db.Uuid
  email               String    @unique
  hashedPassword      String    @map("hashed_password")
  firstName           String    @map("first_name")
  lastName            String?   @map("last_name")
  isActive            Boolean   @default(true) @map("is_active")
  mustChangePassword  Boolean   @default(false) @map("must_change_password")
  failedLoginAttempts Int       @default(0) @map("failed_login_attempts")
  lockedUntil         DateTime? @map("locked_until")
  passwordChangedAt   DateTime? @map("password_changed_at")
  isDeleted           Boolean   @default(false) @map("is_deleted")
  deletedAt           DateTime? @map("deleted_at")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @default(now()) @updatedAt @map("updated_at")

  tenant                    Tenant                     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userRoles                 UserRole[]
  userSchools               UserSchool[]
  refreshTokens             RefreshToken[]
  twoFactor                 UserTwoFactor?
  recoveryCodes             UserRecoveryCode[]
  passwordHistory           UserPasswordHistory[]
  sessions                  UserSession[]
  securityEvents            SecurityEvent[]
  passwordResetTokens       PasswordResetToken[]
  guardian                  Guardian?
  staffAttendances          StaffAttendance[]
  staffLeaves               StaffLeave[]
  requestedStudentLeaves    StudentLeave[]             @relation("StudentLeaveRequestedBy")
  approvedStudentLeaves     StudentLeave[]             @relation("StudentLeaveApprovedBy")
  approvedStaffLeaves       StaffLeave[]               @relation("StaffLeaveApprovedBy")
  classTeacherAssignments   ClassTeacherAssignment[]
  subjectTeacherAssignments SubjectTeacherAssignment[]
  timetableSlots            TimetableSlot[]
  assignedHomework          Homework[]
  finalizedExams            Exam[]                     @relation("ExamFinalizedBy")
  publishedExams            Exam[]                     @relation("ExamPublishedBy")
  invigilatedExams          ExamSchedule[]             @relation("ExamInvigilator")
  enteredMarks              StudentExamMark[]          @relation("MarksEnteredBy")
  updatedMarks              StudentExamMark[]          @relation("MarksUpdatedBy")
  promotions                StudentPromotion[]
  closedFinancialYears        FinancialYear[]       @relation("FinancialYearClosedBy")
  closedAccountingPeriods     AccountingPeriod[]    @relation("PeriodClosedBy")
  reopenedAccountingPeriods   AccountingPeriod[]    @relation("PeriodReopenedBy")
  approvedConcessions         FeeConcession[]       @relation("ConcessionApprovedBy")
  receivedPayments            FeePayment[]          @relation("PaymentReceivedBy")
  reversedPayments            FeePayment[]          @relation("PaymentReversedBy")
  cancelledReceipts           FeeReceipt[]          @relation("ReceiptCancelledBy")
  createdCreditNotes          CreditNote[]          @relation("CreditNoteCreatedBy")
  requestedRefunds            FeeRefund[]           @relation("RefundRequestedBy")
  approvedRefunds             FeeRefund[]           @relation("RefundApprovedBy")
  approvedExpenseBills        ExpenseBill[]         @relation("ExpenseBillApprovedBy")
  createdExpenseBills         ExpenseBill[]         @relation("ExpenseBillCreatedBy")
  createdVendorPayments       VendorPayment[]       @relation("VendorPaymentCreatedBy")
  postedJournalEntries        JournalEntry[]        @relation("JournalPostedBy")
  reversedJournalEntries      JournalEntry[]        @relation("JournalReversedBy")
  createdBankTransfers        BankTransfer[]        @relation("BankTransferCreatedBy")
  importedBankStatements      BankStatementImport[] @relation("BankStatementImportedBy")
  matchedStatementLines       BankStatementLine[]   @relation("StatementLineMatchedBy")
  closedBankReconciliations   BankReconciliation[]  @relation("BankReconciliationClosedBy")
  reopenedBankReconciliations BankReconciliation[] @relation("BankReconciliationReopenedBy")
  employee                    Employee?
  verifiedEmployeeDocuments   EmployeeDocument[]        @relation("DocumentVerifiedBy")
  leaveBalanceTransactions    LeaveBalanceTransaction[] @relation("LeaveTransactionCreatedBy")
  closedPayrollPeriods        PayrollPeriod[]           @relation("PayrollPeriodClosedBy")
  approvedPayrollRuns         PayrollRun[]              @relation("PayrollRunApprovedBy")
  postedPayrollRuns           PayrollRun[]              @relation("PayrollRunPostedBy")
  reversedPayrollRuns         PayrollRun[]              @relation("PayrollRunReversedBy")
  createdPayrollAdjustments   PayrollAdjustment[]       @relation("PayrollAdjustmentCreatedBy")
  createdPayrollPayments      PayrollPayment[]          @relation("PayrollPaymentCreatedBy")
  initiatedSeparations        EmployeeSeparation[]      @relation("SeparationInitiatedBy")
  settledSeparations          EmployeeSeparation[]      @relation("SeparationSettledBy")

  @@map("users")
}

model UserRole {
  userId String @map("user_id") @db.Uuid
  roleId String @map("role_id") @db.Uuid

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_roles")
}

model UserSchool {
  userId   String @map("user_id") @db.Uuid
  schoolId String @map("school_id") @db.Uuid

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@id([userId, schoolId])
  @@map("user_schools")
}

model AcademicYear {
  id        String    @id @default(uuid()) @db.Uuid
  schoolId  String    @map("school_id") @db.Uuid
  name      String
  startDate DateTime  @map("start_date") @db.Date
  endDate   DateTime  @map("end_date") @db.Date
  isCurrent Boolean   @default(false) @map("is_current")
  isClosed  Boolean   @default(false) @map("is_closed")
  isDeleted Boolean   @default(false) @map("is_deleted")
  deletedAt DateTime? @map("deleted_at")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @default(now()) @updatedAt @map("updated_at")

  school                    School                     @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  admissionApplications     AdmissionApplication[]
  studentEnrollments        StudentEnrollment[]
  admittedStudents          Student[]
  schoolHolidays            SchoolHoliday[]
  studentAttendances        StudentAttendance[]
  studentLeaves             StudentLeave[]
  academicTerms             AcademicTerm[]
  classTeacherAssignments   ClassTeacherAssignment[]
  subjectTeacherAssignments SubjectTeacherAssignment[]
  timetableSlots            TimetableSlot[]
  homework                  Homework[]
  exams                     Exam[]
  promotionsFrom            StudentPromotion[]         @relation("PromotionsFromYear")
  promotionsTo              StudentPromotion[]         @relation("PromotionsToYear")
  feeStructures             FeeStructure[]
  studentFeeAssignments     StudentFeeAssignment[]
  feeConcessions            FeeConcession[]
  feeInvoices               FeeInvoice[]

  @@map("academic_years")
}

model NumberSeries {
  id            String   @id @default(uuid()) @db.Uuid
  tenantId      String   @map("tenant_id") @db.Uuid
  schoolId      String?  @map("school_id") @db.Uuid
  code          String
  prefix        String?
  suffix        String?
  padding       Int      @default(4)
  currentValue  Int      @default(0) @map("current_value")
  resetStrategy String?  @map("reset_strategy")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @default(now()) @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("number_series")
}

model AuditLog {
  id           String   @id @default(uuid()) @db.Uuid
  tenantId     String?  @map("tenant_id") @db.Uuid
  schoolId     String?  @map("school_id") @db.Uuid
  userId       String?  @map("user_id") @db.Uuid
  action       String
  entityType   String   @map("entity_type")
  entityId     String?  @map("entity_id")
  beforeData   String?  @map("before_data")
  afterData    String?  @map("after_data")
  metadataInfo String?  @map("metadata_info")
  ipAddress    String?  @map("ip_address")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at")

  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("audit_logs")
}

model RefreshToken {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  token      String   @unique
  expiresAt  BigInt   @map("expires_at")
  isRevoked  Boolean  @default(false) @map("is_revoked")
  replacedBy String?  @map("replaced_by")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @default(now()) @updatedAt @map("updated_at")

  user     User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessions UserSession[]

  @@map("refresh_tokens")
}

model SecurityPolicy {
  id                       String   @id @default(uuid()) @db.Uuid
  tenantId                 String   @unique @map("tenant_id") @db.Uuid
  passwordMinLength        Int      @default(8) @map("password_min_length")
  passwordRequireUppercase Boolean  @default(true) @map("password_require_uppercase")
  passwordRequireLowercase Boolean  @default(true) @map("password_require_lowercase")
  passwordRequireNumber    Boolean  @default(true) @map("password_require_number")
  passwordRequireSpecial   Boolean  @default(false) @map("password_require_special")
  passwordHistoryCount     Int      @default(3) @map("password_history_count")
  passwordExpiryDays       Int      @default(0) @map("password_expiry_days")
  maxFailedAttempts        Int      @default(5) @map("max_failed_attempts")
  lockoutMinutes           Int      @default(15) @map("lockout_minutes")
  ipRestrictionMode        String   @default("DISABLED") @map("ip_restriction_mode")
  require2faForAdmins      Boolean  @default(false) @map("require_2fa_for_admins")
  createdAt                DateTime @default(now()) @map("created_at")
  updatedAt                DateTime @default(now()) @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("security_policies")
}

model UserTwoFactor {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @unique @map("user_id") @db.Uuid
  totpSecret String   @map("totp_secret")
  isActive   Boolean  @default(false) @map("is_active")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @default(now()) @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_two_factor")
}

model UserRecoveryCode {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  hashedCode String    @map("hashed_code")
  usedAt     DateTime? @map("used_at")
  isActive   Boolean   @default(false) @map("is_active")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @default(now()) @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_recovery_codes")
}

model UserPasswordHistory {
  id             String   @id @default(uuid()) @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  hashedPassword String   @map("hashed_password")
  createdAt      DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_password_history")
}

model UserSession {
  id             String   @id @default(uuid()) @db.Uuid
  tenantId       String   @map("tenant_id") @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  refreshTokenId String?  @map("refresh_token_id") @db.Uuid
  ipAddress      String?  @map("ip_address")
  userAgent      String?  @map("user_agent")
  deviceCategory String?  @map("device_category")
  lastActivityAt DateTime @default(now()) @map("last_activity_at")
  expiresAt      DateTime @map("expires_at")
  isRevoked      Boolean  @default(false) @map("is_revoked")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @default(now()) @updatedAt @map("updated_at")

  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshToken RefreshToken? @relation(fields: [refreshTokenId], references: [id], onDelete: Cascade)

  @@map("user_sessions")
}

model IpRestriction {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  schoolId    String?  @map("school_id") @db.Uuid
  networkCidr String   @map("network_cidr")
  ruleType    String   @map("rule_type")
  isEnabled   Boolean  @default(true) @map("is_enabled")
  description String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at")

  tenant Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  school School? @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@map("ip_restrictions")
}

model SecurityEvent {
  id           String   @id @default(uuid()) @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  userId       String?  @map("user_id") @db.Uuid
  eventType    String   @map("event_type")
  severity     String   @default("INFO")
  ipAddress    String?  @map("ip_address")
  metadataInfo String?  @map("metadata_info")
  createdAt    DateTime @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User?  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("security_events")
}

model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @default(now()) @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("password_reset_tokens")
}

model SchoolConfiguration {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  schoolId  String   @unique @map("school_id") @db.Uuid
  version   Int      @default(1)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  // School identity
  legalName         String? @map("legal_name") @db.VarChar(200)
  shortName         String? @map("short_name") @db.VarChar(100)
  board             String  @default("OTHER") @db.VarChar(30)
  affiliationNumber String? @map("affiliation_number") @db.VarChar(100)
  udiseCode         String? @map("udise_code") @db.VarChar(50)
  primaryPhone      String? @map("primary_phone") @db.VarChar(30)
  secondaryPhone    String? @map("secondary_phone") @db.VarChar(30)
  contactEmail      String? @map("contact_email") @db.VarChar(255)
  website           String? @db.VarChar(255)
  addressLine1      String? @map("address_line_1") @db.VarChar(255)
  addressLine2      String? @map("address_line_2") @db.VarChar(255)
  city              String? @db.VarChar(100)
  state             String? @db.VarChar(100)
  postalCode        String? @map("postal_code") @db.VarChar(20)
  country           String  @default("IN") @db.VarChar(2)

  // Academic
  workingWeek            String  @default("MON_SAT") @map("working_week") @db.VarChar(20)
  weekStart              Int     @default(1) @map("week_start")
  termNaming             String  @default("TERM") @map("term_naming") @db.VarChar(30)
  rollNumberScope        String  @default("CLASS_SECTION_YEAR") @map("roll_number_scope") @db.VarChar(30)
  academicLockingEnabled Boolean @default(true) @map("academic_locking_enabled")

  // Student Identity Formats
  studentIdFormat       String @default("STU-{YYYY}-{SEQ:05}") @map("student_id_format") @db.VarChar(100)
  admissionNumberFormat String @default("ADM-{YY}-{SEQ:04}") @map("admission_number_format") @db.VarChar(100)
  rollNumberFormat      String @default("{SEQ:03}") @map("roll_number_format") @db.VarChar(100)

  // Attendance
  attendanceLockEnabled              Boolean  @default(true) @map("attendance_lock_enabled")
  attendanceLockHours                Int      @default(24) @map("attendance_lock_hours")
  attendanceCorrectionAllowed        Boolean  @default(true) @map("attendance_correction_allowed")
  attendanceCorrectionReasonRequired Boolean  @default(true) @map("attendance_correction_reason_required")
  attendancePrincipalOverride        Boolean  @default(true) @map("attendance_principal_override")
