  addressLine2      String?  @map("address_line_2") @db.VarChar(255)
  city              String?  @db.VarChar(100)
  state             String?  @db.VarChar(100)
  postalCode        String?  @map("postal_code") @db.VarChar(20)
  country           String   @default("IN") @db.VarChar(50)

  // Guardian details captured at application time
  guardianName         String  @map("guardian_name") @db.VarChar(200)
  guardianRelationship String  @map("guardian_relationship") @db.VarChar(50)
  guardianPhone        String  @map("guardian_phone") @db.VarChar(30)
  guardianAltPhone     String? @map("guardian_alt_phone") @db.VarChar(30)
  guardianEmail        String? @map("guardian_email") @db.VarChar(255)
  guardianOccupation   String? @map("guardian_occupation") @db.VarChar(100)
  guardianId           String? @map("guardian_id") @db.Uuid

  // Review & Conversion
  reviewNotes     String?   @map("review_notes") @db.Text
  rejectionReason String?   @map("rejection_reason") @db.VarChar(500)
  reviewedBy      String?   @map("reviewed_by") @db.Uuid
  reviewedAt      DateTime? @map("reviewed_at")
  convertedAt     DateTime? @map("converted_at")

  archivedAt DateTime? @map("archived_at")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @default(now()) @updatedAt @map("updated_at")

  tenant           Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  school           School            @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  academicYear     AcademicYear      @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  appliedClass     ClassMaster       @relation(fields: [appliedClassId], references: [id], onDelete: Cascade)
  convertedStudent Student?          @relation("StudentAdmissionApplication")
  documents        StudentDocument[]

  @@unique([schoolId, applicationNumber])
  @@index([schoolId, status])
  @@index([schoolId, academicYearId, appliedClassId])
  @@map("admission_applications")
}

