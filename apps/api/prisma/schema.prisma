// ==========================================
// MAJOR MODULE 07: FINANCE & ACCOUNTING
// ==========================================

model FinancialYear {
  id             String    @id @default(uuid()) @db.Uuid
  tenantId       String    @map("tenant_id") @db.Uuid
  schoolId       String    @map("school_id") @db.Uuid
  name           String    @db.VarChar(100) // e.g. "FY 2026-27"
  startDate      DateTime  @map("start_date") @db.Date
  endDate        DateTime  @map("end_date") @db.Date
  status         String    @default("OPEN") @db.VarChar(20) // OPEN, CLOSED
  isClosed       Boolean   @default(false) @map("is_closed")
  closedAt       DateTime? @map("closed_at")
  closedByUserId String?   @map("closed_by_user_id") @db.Uuid
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @default(now()) @updatedAt @map("updated_at")

  tenant            Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  school            School             @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  closedByUser      User?              @relation("FinancialYearClosedBy", fields: [closedByUserId], references: [id], onDelete: SetNull)
  accountingPeriods AccountingPeriod[]
  journalEntries    JournalEntry[]
  feeInvoices       FeeInvoice[]
  feePayments       FeePayment[]
  expenseBills      ExpenseBill[]
  bankTransfers     BankTransfer[]
  payrollPeriods    PayrollPeriod[]
  payrollRuns       PayrollRun[]

  @@unique([schoolId, name])
  @@index([tenantId, schoolId, status])
  @@map("financial_years")
}

model AccountingPeriod {
  id               String    @id @default(uuid()) @db.Uuid
  tenantId         String    @map("tenant_id") @db.Uuid
  schoolId         String    @map("school_id") @db.Uuid
  financialYearId  String    @map("financial_year_id") @db.Uuid
  name             String    @db.VarChar(100) // e.g. "April 2026", "Q1 2026"
  startDate        DateTime  @map("start_date") @db.Date
  endDate          DateTime  @map("end_date") @db.Date
  status           String    @default("OPEN") @db.VarChar(20) // OPEN, CLOSED, LOCKED
  closedAt         DateTime? @map("closed_at")
  closedByUserId   String?   @map("closed_by_user_id") @db.Uuid
  reopenedAt       DateTime? @map("reopened_at")
  reopenedByUserId String?   @map("reopened_by_user_id") @db.Uuid
  reopenReason     String?   @map("reopen_reason") @db.VarChar(255)
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @default(now()) @updatedAt @map("updated_at")

  tenant          Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  school          School        @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  financialYear   FinancialYear @relation(fields: [financialYearId], references: [id], onDelete: Cascade)
  closedByUser    User?         @relation("PeriodClosedBy", fields: [closedByUserId], references: [id], onDelete: SetNull)
  reopenedByUser  User?         @relation("PeriodReopenedBy", fields: [reopenedByUserId], references: [id], onDelete: SetNull)
  journalEntries  JournalEntry[]

  @@unique([financialYearId, name])
  @@index([tenantId, schoolId, status])
  @@index([financialYearId, startDate, endDate])
  @@map("accounting_periods")
}

model Account {
  id               String    @id @default(uuid()) @db.Uuid
  tenantId         String    @map("tenant_id") @db.Uuid
  schoolId         String    @map("school_id") @db.Uuid
  code             String    @db.VarChar(50) // e.g. "1010", "1020", "2010", "4010", "5010"
  name             String    @db.VarChar(150)
  type             String    @db.VarChar(30) // ASSET, LIABILITY, EQUITY, INCOME, EXPENSE
  parentAccountId  String?   @map("parent_account_id") @db.Uuid
  normalBalance    String    @map("normal_balance") @db.VarChar(10) // DEBIT, CREDIT
  description      String?   @db.VarChar(255)
  isSystemAccount  Boolean   @default(false) @map("is_system_account")
  systemMapping    String?   @map("system_mapping") @db.VarChar(50) // FEE_RECEIVABLE, CASH, BANK, STUDENT_ADVANCE, FEE_INCOME, CONCESSION, BAD_DEBT, VENDOR_PAYABLE, OPENING_BALANCE_EQUITY
  currency         String    @default("INR") @db.VarChar(10)
  isActive         Boolean   @default(true) @map("is_active")
  isArchived       Boolean   @default(false) @map("is_archived")
  archivedAt       DateTime? @map("archived_at")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @default(now()) @updatedAt @map("updated_at")

  tenant           Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  school           School        @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  parentAccount    Account?      @relation("AccountHierarchy", fields: [parentAccountId], references: [id], onDelete: SetNull)
  subAccounts      Account[]     @relation("AccountHierarchy")
  journalLines     JournalLine[]
  receivingPayments FeePayment[]
  disbursingRefunds FeeRefund[]
  expenseBillLines ExpenseBillLine[]
  disbursingVendorPayments VendorPayment[]
  bankAccount      BankAccount?
  transfersFrom    BankTransfer[] @relation("TransferFromAccount")
  transfersTo      BankTransfer[] @relation("TransferToAccount")
  feeHeads         FeeHead[]
  expenseHeads     ExpenseHead[]
  salaryComponentExpenses           SalaryComponent[]      @relation("ComponentExpenseAccount")
  salaryComponentLiabilities        SalaryComponent[]      @relation("ComponentLiabilityAccount")
  payrollExpenseConfigurations      PayrollConfiguration[] @relation("PayrollExpenseAccount")
  payrollPayableConfigurations      PayrollConfiguration[] @relation("PayrollPayableAccount")
  payrollDisbursementConfigurations PayrollConfiguration[] @relation("PayrollDisbursementAccount")
  disbursingPayrollPayments         PayrollPayment[]       @relation("PayrollDisbursingAccount")

  @@unique([schoolId, code])
  @@index([tenantId, schoolId, type, isActive])
  @@map("accounts")
}

model FeeStructure {
  id                String    @id @default(uuid()) @db.Uuid
  tenantId          String    @map("tenant_id") @db.Uuid
  schoolId          String    @map("school_id") @db.Uuid
  academicYearId    String    @map("academic_year_id") @db.Uuid
  classId           String?   @map("class_id") @db.Uuid
  studentCategoryId String?   @map("student_category_id") @db.Uuid
  name              String    @db.VarChar(100)
  code              String    @db.VarChar(50)
  currency          String    @default("INR") @db.VarChar(10)
  frequency         String    @default("ANNUAL") @db.VarChar(30) // ANNUAL, TERMLY, MONTHLY, ONE_TIME
  effectiveDate     DateTime  @default(now()) @map("effective_date")
  status            String    @default("ACTIVE") @db.VarChar(20) // DRAFT, ACTIVE, ARCHIVED
  version           Int       @default(1)
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @default(now()) @updatedAt @map("updated_at")

  tenant            Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  school            School              @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  academicYear      AcademicYear        @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  class             ClassMaster?        @relation(fields: [classId], references: [id], onDelete: SetNull)
  studentCategory   StudentCategory?    @relation(fields: [studentCategoryId], references: [id], onDelete: SetNull)
  items             FeeStructureItem[]
  installments      FeeInstallment[]
  studentAssignments StudentFeeAssignment[]

  @@unique([schoolId, code])
  @@index([schoolId, academicYearId, classId])
  @@map("fee_structures")
}

model FeeStructureItem {
  id             String       @id @default(uuid()) @db.Uuid
  feeStructureId String       @map("fee_structure_id") @db.Uuid
  feeHeadId      String       @map("fee_head_id") @db.Uuid
  amount         Decimal      @db.Decimal(12, 2)
  dueDate        DateTime?    @map("due_date")
  isOptional     Boolean      @default(false) @map("is_optional")
  displayOrder   Int          @default(0) @map("display_order")

  feeStructure   FeeStructure @relation(fields: [feeStructureId], references: [id], onDelete: Cascade)
  feeHead        FeeHead      @relation(fields: [feeHeadId], references: [id], onDelete: Cascade)

  @@map("fee_structure_items")
}

model FeeInstallment {
  id             String       @id @default(uuid()) @db.Uuid
  tenantId       String       @map("tenant_id") @db.Uuid
  schoolId       String       @map("school_id") @db.Uuid
  feeStructureId String       @map("fee_structure_id") @db.Uuid
  name           String       @db.VarChar(100)
  sequence       Int          @default(1)
  dueDate        DateTime     @map("due_date")
  amount         Decimal      @db.Decimal(12, 2)
  lateFeeRule    String?      @map("late_fee_rule") @db.VarChar(30)
  lateFeeAmount  Decimal?     @map("late_fee_amount") @db.Decimal(12, 2)
  graceDays      Int          @default(0) @map("grace_days")

  tenant         Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  school         School       @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  feeStructure   FeeStructure @relation(fields: [feeStructureId], references: [id], onDelete: Cascade)

  @@map("fee_installments")
}

model StudentFeeAssignment {
  id             String    @id @default(uuid()) @db.Uuid
  tenantId       String    @map("tenant_id") @db.Uuid
  schoolId       String    @map("school_id") @db.Uuid
  studentId      String    @map("student_id") @db.Uuid
  academicYearId String    @map("academic_year_id") @db.Uuid
  feeStructureId String    @map("fee_structure_id") @db.Uuid
  overrideAmount Decimal?  @map("override_amount") @db.Decimal(12, 2)
  overrideReason String?   @map("override_reason") @db.VarChar(255)
  status         String    @default("ACTIVE") @db.VarChar(20) // ACTIVE, SUSPENDED, COMPLETED
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @default(now()) @updatedAt @map("updated_at")

  tenant         Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  school         School       @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  student        Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  feeStructure   FeeStructure @relation(fields: [feeStructureId], references: [id], onDelete: Cascade)

  @@unique([schoolId, studentId, academicYearId, feeStructureId])
  @@index([studentId, academicYearId])
  @@map("student_fee_assignments")
}

model FeeConcession {
  id               String    @id @default(uuid()) @db.Uuid
  tenantId         String    @map("tenant_id") @db.Uuid
  schoolId         String    @map("school_id") @db.Uuid
  studentId        String    @map("student_id") @db.Uuid
  feeHeadId        String?   @map("fee_head_id") @db.Uuid
  academicYearId   String    @map("academic_year_id") @db.Uuid
  name             String    @db.VarChar(100)
  concessionType   String    @map("concession_type") @db.VarChar(30) // FIXED_AMOUNT, PERCENTAGE
  value            Decimal   @db.Decimal(12, 2)
  reason           String    @db.VarChar(255)
  status           String    @default("PENDING") @db.VarChar(20) // PENDING, APPROVED, REJECTED
  approvedByUserId String?   @map("approved_by_user_id") @db.Uuid
  approvedAt       DateTime? @map("approved_at")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @default(now()) @updatedAt @map("updated_at")

  tenant           Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  school           School       @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  student          Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  feeHead          FeeHead?     @relation(fields: [feeHeadId], references: [id], onDelete: SetNull)
  academicYear     AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  approvedByUser   User?        @relation("ConcessionApprovedBy", fields: [approvedByUserId], references: [id], onDelete: SetNull)

  @@index([tenantId, schoolId, studentId])
  @@map("fee_concessions")
}

model FeeInvoice {
  id                  String   @id @default(uuid()) @db.Uuid
  tenantId            String   @map("tenant_id") @db.Uuid
  schoolId            String   @map("school_id") @db.Uuid
  studentId           String   @map("student_id") @db.Uuid
  academicYearId      String   @map("academic_year_id") @db.Uuid
  financialYearId     String   @map("financial_year_id") @db.Uuid
  invoiceNumber       String   @map("invoice_number") @db.VarChar(50)
  invoiceDate         DateTime @map("invoice_date")
  dueDate             DateTime @map("due_date")
  subtotal            Decimal  @db.Decimal(12, 2)
  concessionTotal     Decimal  @default(0) @map("concession_total") @db.Decimal(12, 2)
  lateFeeAmount       Decimal  @default(0) @map("late_fee_amount") @db.Decimal(12, 2)
  totalAmount         Decimal  @map("total_amount") @db.Decimal(12, 2)
  paidAmount          Decimal  @default(0) @map("paid_amount") @db.Decimal(12, 2)
  outstandingAmount   Decimal  @map("outstanding_amount") @db.Decimal(12, 2)
  status              String   @default("POSTED") @db.VarChar(20) // DRAFT, POSTED, PARTIALLY_PAID, PAID, CANCELLED, REVERSED
  generationSourceKey String?  @map("generation_source_key") @db.VarChar(150)
  journalEntryId      String?  @map("journal_entry_id") @db.Uuid
  version             Int      @default(1)
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @default(now()) @updatedAt @map("updated_at")

  tenant              Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  school              School               @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  student             Student              @relation(fields: [studentId], references: [id], onDelete: Cascade)
  academicYear        AcademicYear         @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  financialYear       FinancialYear        @relation(fields: [financialYearId], references: [id], onDelete: Cascade)
  journalEntry        JournalEntry?        @relation(fields: [journalEntryId], references: [id], onDelete: SetNull)
  lines               FeeInvoiceLine[]
  allocations         FeePaymentAllocation[]
  creditNotes         CreditNote[]

  @@unique([schoolId, invoiceNumber])
  @@index([schoolId, studentId, status, dueDate])
  @@index([tenantId, schoolId, invoiceDate])
  @@map("fee_invoices")
}

model FeeInvoiceLine {
  id               String      @id @default(uuid()) @db.Uuid
  feeInvoiceId     String      @map("fee_invoice_id") @db.Uuid
  feeHeadId        String      @map("fee_head_id") @db.Uuid
  description      String      @db.VarChar(255)
  quantity         Int         @default(1)
  rate             Decimal     @db.Decimal(12, 2)
  amount           Decimal     @db.Decimal(12, 2)
  concessionAmount Decimal     @default(0) @map("concession_amount") @db.Decimal(12, 2)
  netAmount        Decimal     @map("net_amount") @db.Decimal(12, 2)

  feeInvoice       FeeInvoice  @relation(fields: [feeInvoiceId], references: [id], onDelete: Cascade)
  feeHead          FeeHead     @relation(fields: [feeHeadId], references: [id], onDelete: Cascade)

  @@map("fee_invoice_lines")
}

model FeePayment {
  id                    String    @id @default(uuid()) @db.Uuid
  tenantId              String    @map("tenant_id") @db.Uuid
  schoolId              String    @map("school_id") @db.Uuid
  studentId             String    @map("student_id") @db.Uuid
  financialYearId       String    @map("financial_year_id") @db.Uuid
  receiptNumber         String    @map("receipt_number") @db.VarChar(50)
  paymentDate           DateTime  @map("payment_date")
  totalAmount           Decimal   @map("total_amount") @db.Decimal(12, 2)
  allocatedAmount       Decimal   @map("allocated_amount") @db.Decimal(12, 2)
  advanceAmount         Decimal   @default(0) @map("advance_amount") @db.Decimal(12, 2)
  paymentMethod         String    @map("payment_method") @db.VarChar(30)
  receivingAccountId    String    @map("receiving_account_id") @db.Uuid
  transactionReference  String?   @map("transaction_reference") @db.VarChar(100)
  chequeNumber          String?   @map("cheque_number") @db.VarChar(50)
  chequeDate            DateTime? @map("cheque_date")
  bankName              String?   @map("bank_name") @db.VarChar(100)
  chequeClearanceStatus String?   @map("cheque_clearance_status") @db.VarChar(20) // PENDING, CLEARED, BOUNCED
  chequeClearedAt       DateTime? @map("cheque_cleared_at")
  chequeBouncedAt       DateTime? @map("cheque_bounced_at")
  chequeBounceReason    String?   @map("cheque_bounce_reason") @db.VarChar(255)
  status                String    @default("POSTED") @db.VarChar(20) // POSTED, REVERSED, BOUNCED
  remarks               String?   @db.VarChar(255)
  receivedByUserId      String    @map("received_by_user_id") @db.Uuid
  idempotencyKey        String?   @map("idempotency_key") @db.VarChar(100)
  journalEntryId        String?   @map("journal_entry_id") @db.Uuid
  reversalJournalEntryId String?  @map("reversal_journal_entry_id") @db.Uuid
  reversedAt            DateTime? @map("reversed_at")
  reversedByUserId      String?   @map("reversed_by_user_id") @db.Uuid
  reversalReason        String?   @map("reversal_reason") @db.VarChar(255)
  createdAt             DateTime  @default(now()) @map("created_at")

  tenant                Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  school                School                 @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  student               Student                @relation(fields: [studentId], references: [id], onDelete: Cascade)
  financialYear         FinancialYear          @relation(fields: [financialYearId], references: [id], onDelete: Cascade)
  receivingAccount      Account                @relation(fields: [receivingAccountId], references: [id], onDelete: Restrict)
  receivedByUser        User                   @relation("PaymentReceivedBy", fields: [receivedByUserId], references: [id], onDelete: Cascade)
  reversedByUser        User?                  @relation("PaymentReversedBy", fields: [reversedByUserId], references: [id], onDelete: SetNull)
