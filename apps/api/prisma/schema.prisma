  photoFileId       String?  @map("photo_file_id") @db.VarChar(255)
  photoStorageKey   String?  @map("photo_storage_key") @db.VarChar(500)
  previousSchool    String?  @map("previous_school") @db.VarChar(255)
  previousClass     String?  @map("previous_class") @db.VarChar(100)
