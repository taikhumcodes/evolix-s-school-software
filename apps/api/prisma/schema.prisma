  totalRemainingPayable      Decimal   @default(0) @map("total_remaining_payable") @db.Decimal(12, 2)
  journalEntryId             String?   @map("journal_entry_id") @db.Uuid
  reversalJournalEntryId     String?   @map("reversal_journal_entry_id") @db.Uuid
  reversalReason             String?   @map("reversal_reason") @db.VarChar(255)
  approvedByUserId           String?   @map("approved_by_user_id") @db.Uuid
  approvedAt                 DateTime? @map("approved_at")
  postedByUserId             String?   @map("posted_by_user_id") @db.Uuid
  postedAt                   DateTime? @map("posted_at")
  paidAt                     DateTime? @map("paid_at")
  closedAt                   DateTime? @map("closed_at")
  reversedAt                 DateTime? @map("reversed_at")
  reversedByUserId           String?   @map("reversed_by_user_id") @db.Uuid
  remarks                    String?   @db.VarChar(255)
  createdAt                  DateTime  @default(now()) @map("created_at")
  updatedAt                  DateTime  @default(now()) @updatedAt @map("updated_at")

  tenant               Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  school               School               @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  period               PayrollPeriod        @relation(fields: [periodId], references: [id], onDelete: Cascade)
  financialYear        FinancialYear        @relation(fields: [financialYearId], references: [id], onDelete: Cascade)
  journalEntry         JournalEntry?        @relation("PayrollRunJournal", fields: [journalEntryId], references: [id], onDelete: SetNull)
  reversalJournalEntry JournalEntry?        @relation("PayrollRunReversalJournal", fields: [reversalJournalEntryId], references: [id], onDelete: SetNull)
  approvedByUser       User?                @relation("PayrollRunApprovedBy", fields: [approvedByUserId], references: [id], onDelete: SetNull)
  postedByUser         User?                @relation("PayrollRunPostedBy", fields: [postedByUserId], references: [id], onDelete: SetNull)
  reversedByUser       User?                @relation("PayrollRunReversedBy", fields: [reversedByUserId], references: [id], onDelete: SetNull)
  employees            PayrollRunEmployee[]
  payments             PayrollPayment[]
  adjustments          PayrollAdjustment[]
  settlementSeparations EmployeeSeparation[]

  @@unique([schoolId, runNumber])
  @@index([tenantId, schoolId, periodId, status])
  @@map("payroll_runs")
}

model PayrollRunEmployee {
  id                    String   @id @default(uuid()) @db.Uuid
  payrollRunId          String   @map("payroll_run_id") @db.Uuid
  employeeId            String   @map("employee_id") @db.Uuid
  salaryStructureId     String?  @map("salary_structure_id") @db.Uuid
  baseSalary            Decimal  @map("base_salary") @db.Decimal(12, 2)
  workingDays           Decimal  @default(0) @map("working_days") @db.Decimal(5, 1)
  presentDays           Decimal  @default(0) @map("present_days") @db.Decimal(5, 1)
  paidLeaveDays         Decimal  @default(0) @map("paid_leave_days") @db.Decimal(5, 1)
  absentDays            Decimal  @default(0) @map("absent_days") @db.Decimal(5, 1)
  unpaidLeaveDays       Decimal  @default(0) @map("unpaid_leave_days") @db.Decimal(5, 1)
  lossOfPayDays         Decimal  @default(0) @map("loss_of_pay_days") @db.Decimal(5, 1)
  grossEarnings         Decimal  @default(0) @map("gross_earnings") @db.Decimal(12, 2)
  totalDeductions       Decimal  @default(0) @map("total_deductions") @db.Decimal(12, 2)
  employerContributions Decimal  @default(0) @map("employer_contributions") @db.Decimal(12, 2)
  netPay                Decimal  @default(0) @map("net_pay") @db.Decimal(12, 2)
  paidAmount            Decimal  @default(0) @map("paid_amount") @db.Decimal(12, 2)
  remainingPayable      Decimal  @default(0) @map("remaining_payable") @db.Decimal(12, 2)
  paymentStatus         String   @default("UNPAID") @map("payment_status") @db.VarChar(20)
  calculationSnapshot   Json     @map("calculation_snapshot")
  remarks               String?  @db.VarChar(255)
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @default(now()) @updatedAt @map("updated_at")

  payrollRun         PayrollRun                 @relation(fields: [payrollRunId], references: [id], onDelete: Cascade)
  employee           Employee                   @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  salaryStructure    SalaryStructure?           @relation(fields: [salaryStructureId], references: [id], onDelete: SetNull)
  lineItems          PayrollLineItem[]
  paymentAllocations PayrollPaymentAllocation[]

  @@unique([payrollRunId, employeeId])
  @@index([employeeId, paymentStatus])
  @@map("payroll_run_employees")
}

model PayrollLineItem {
  id                   String   @id @default(uuid()) @db.Uuid
  payrollRunEmployeeId String   @map("payroll_run_employee_id") @db.Uuid
  componentId          String   @map("component_id") @db.Uuid
  componentName        String   @map("component_name") @db.VarChar(100)
  componentCode        String   @map("component_code") @db.VarChar(50)
  componentType        String   @map("component_type") @db.VarChar(30)
  calculatedAmount     Decimal  @map("calculated_amount") @db.Decimal(12, 2)
  rateApplied          Decimal? @map("rate_applied") @db.Decimal(6, 3)
  remarks              String?  @db.VarChar(255)
  createdAt            DateTime @default(now()) @map("created_at")

  payrollRunEmployee PayrollRunEmployee @relation(fields: [payrollRunEmployeeId], references: [id], onDelete: Cascade)

  @@index([payrollRunEmployeeId, componentType])
  @@map("payroll_line_items")
}

model PayrollAdjustment {
  id              String   @id @default(uuid()) @db.Uuid
  tenantId        String   @map("tenant_id") @db.Uuid
  schoolId        String   @map("school_id") @db.Uuid
  employeeId      String   @map("employee_id") @db.Uuid
  periodId        String   @map("period_id") @db.Uuid
  payrollRunId    String?  @map("payroll_run_id") @db.Uuid
  type            String   @db.VarChar(20)
  name            String   @db.VarChar(100)
  amount          Decimal  @db.Decimal(12, 2)
  reason          String   @db.VarChar(255)
  status          String   @default("PENDING") @db.VarChar(20)
  appliedInRunId  String?  @map("applied_in_run_id") @db.Uuid
  createdByUserId String   @map("created_by_user_id") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at")

  tenant        Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  school        School        @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  employee      Employee      @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  period        PayrollPeriod @relation(fields: [periodId], references: [id], onDelete: Cascade)
  payrollRun    PayrollRun?   @relation(fields: [payrollRunId], references: [id], onDelete: SetNull)
  createdByUser User          @relation("PayrollAdjustmentCreatedBy", fields: [createdByUserId], references: [id], onDelete: Cascade)

  @@index([schoolId, employeeId, periodId, status])
  @@map("payroll_adjustments")
}

model PayrollPayment {
  id                  String   @id @default(uuid()) @db.Uuid
  tenantId            String   @map("tenant_id") @db.Uuid
  schoolId            String   @map("school_id") @db.Uuid
  payrollRunId        String   @map("payroll_run_id") @db.Uuid
  paymentNumber       String   @map("payment_number") @db.VarChar(50)
  paymentDate         DateTime @map("payment_date")
  paymentMethod       String   @map("payment_method") @db.VarChar(30)
  disbursingAccountId String   @map("disbursing_account_id") @db.Uuid
  bankAccountId       String?  @map("bank_account_id") @db.Uuid
  totalAmount         Decimal  @map("total_amount") @db.Decimal(12, 2)
  referenceNumber     String?  @map("reference_number") @db.VarChar(100)
  remarks             String?  @db.VarChar(255)
  idempotencyKey      String?  @map("idempotency_key") @db.VarChar(100)
  journalEntryId      String?  @map("journal_entry_id") @db.Uuid
  createdByUserId     String   @map("created_by_user_id") @db.Uuid
  createdAt           DateTime @default(now()) @map("created_at")

  tenant            Tenant                     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  school            School                     @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  payrollRun        PayrollRun                 @relation(fields: [payrollRunId], references: [id], onDelete: Restrict)
  disbursingAccount Account                    @relation("PayrollDisbursingAccount", fields: [disbursingAccountId], references: [id], onDelete: Restrict)
  bankAccount       BankAccount?               @relation(fields: [bankAccountId], references: [id], onDelete: SetNull)
  journalEntry      JournalEntry?              @relation("PayrollPaymentJournal", fields: [journalEntryId], references: [id], onDelete: SetNull)
  createdByUser     User                       @relation("PayrollPaymentCreatedBy", fields: [createdByUserId], references: [id], onDelete: Cascade)
  allocations       PayrollPaymentAllocation[]

  @@unique([schoolId, paymentNumber])
  @@unique([schoolId, idempotencyKey])
  @@index([tenantId, schoolId, payrollRunId])
  @@map("payroll_payments")
}

model PayrollPaymentAllocation {
  id                   String   @id @default(uuid()) @db.Uuid
  payrollPaymentId     String   @map("payroll_payment_id") @db.Uuid
  payrollRunEmployeeId String   @map("payroll_run_employee_id") @db.Uuid
  employeeId           String   @map("employee_id") @db.Uuid
  amount               Decimal  @db.Decimal(12, 2)
  createdAt            DateTime @default(now()) @map("created_at")

  payrollPayment     PayrollPayment     @relation(fields: [payrollPaymentId], references: [id], onDelete: Cascade)
  payrollRunEmployee PayrollRunEmployee @relation(fields: [payrollRunEmployeeId], references: [id], onDelete: Cascade)
  employee           Employee           @relation(fields: [employeeId], references: [id], onDelete: Restrict)

  @@index([payrollPaymentId])
  @@index([payrollRunEmployeeId])
  @@index([employeeId])
  @@map("payroll_payment_allocations")
}

model EmployeeSeparation {
  id                      String    @id @default(uuid()) @db.Uuid
  tenantId                String    @map("tenant_id") @db.Uuid
  schoolId                String    @map("school_id") @db.Uuid
  employeeId              String    @map("employee_id") @db.Uuid
  noticeDate              DateTime  @map("notice_date") @db.Date
  resignationDate         DateTime? @map("resignation_date") @db.Date
  expectedLastWorkingDate DateTime  @map("expected_last_working_date") @db.Date
  actualLastWorkingDate   DateTime? @map("actual_last_working_date") @db.Date
  separationType          String    @map("separation_type") @db.VarChar(30)
  reason                  String    @db.Text
  status                  String    @default("INITIATED") @db.VarChar(30)
  clearanceStatus         Json?     @map("clearance_status")
  gratuityAmount          Decimal   @default(0) @map("gratuity_amount") @db.Decimal(12, 2)
  encashmentAmount        Decimal   @default(0) @map("encashment_amount") @db.Decimal(12, 2)
  noticePayAmount         Decimal   @default(0) @map("notice_pay_amount") @db.Decimal(12, 2)
  otherAdditions          Decimal   @default(0) @map("other_additions") @db.Decimal(12, 2)
  otherDeductions         Decimal   @default(0) @map("other_deductions") @db.Decimal(12, 2)
  finalPayableAmount      Decimal   @default(0) @map("final_payable_amount") @db.Decimal(12, 2)
  settlementPayrollRunId  String?   @map("settlement_payroll_run_id") @db.Uuid
  remarks                 String?   @db.VarChar(255)
  initiatedByUserId       String    @map("initiated_by_user_id") @db.Uuid
  settledByUserId         String?   @map("settled_by_user_id") @db.Uuid
  settledAt               DateTime? @map("settled_at")
  createdAt               DateTime  @default(now()) @map("created_at")
  updatedAt               DateTime  @default(now()) @updatedAt @map("updated_at")

  tenant               Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  school               School      @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  employee             Employee    @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  settlementPayrollRun PayrollRun? @relation(fields: [settlementPayrollRunId], references: [id], onDelete: SetNull)
  initiatedByUser      User        @relation("SeparationInitiatedBy", fields: [initiatedByUserId], references: [id], onDelete: Cascade)
  settledByUser        User?       @relation("SeparationSettledBy", fields: [settledByUserId], references: [id], onDelete: SetNull)

  @@index([tenantId, schoolId, employeeId, status])
  @@map("employee_separations")
}
